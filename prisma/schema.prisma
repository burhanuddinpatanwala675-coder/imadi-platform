generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's DATABASE_URL is the pooled (PgBouncer, transaction-mode) endpoint,
  // which is right for normal app queries but breaks `prisma migrate deploy`:
  // the migration engine needs a session-level Postgres advisory lock, which
  // a transaction-mode pooler can't reliably hold, so migrations time out
  // waiting for a lock they can never get. DIRECT_URL should be Neon's
  // direct (non-pooled) connection string — same credentials/database, just
  // without "-pooler" in the hostname. Only migrate commands use this;
  // the running app still queries through the pooled DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  super_admin
  editor
  sales
}

enum InquiryStatus {
  new
  contacted
  qualified
  proposal_sent
  won
  lost
  archived
}

enum SubscriberStatus {
  active
  unsubscribed
}

enum ContentStatus {
  draft
  published
  archived
}

model AdminUser {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(editor)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedInquiries ContactInquiry[] @relation("Assigned")
  posts              BlogPost[]
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model ContactInquiry {
  id          String @id @default(cuid())
  name        String
  workEmail   String
  companyName String
  phoneNumber String?

  projectType String
  budgetRange String?
  message     String
  sourcePage  String

  // Optional context captured by the expanded contact form — none of these
  // are required, so older submissions simply have them as null.
  website   String?
  toolsUsed String?
  timeline  String?

  status InquiryStatus @default(new)

  assignedToId String?
  assignedTo   AdminUser? @relation("Assigned", fields: [assignedToId], references: [id])

  notes String?
  utm   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model NewsletterSubscriber {
  id    String @id @default(cuid())
  email String @unique

  firstName String?

  status SubscriberStatus @default(active)

  consentAt DateTime @default(now())

  unsubscribeToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  excerpt String
  content String

  coverImageUrl String?

  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  category String
  tags     String[]

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?

  status ContentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseStudy {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  clientName String?
  industry   String

  // Project-type category driving the filter pills on the public
  // /case-studies/ index (AI & Automation, SaaS Products, Operations,
  // E-commerce, Social Impact, Custom Software). Optional — hides from
  // every filter until set.
  projectType String?

  // Marks a case study for prominent placement — featured items sort first
  // on both the homepage proof section and the case-studies index.
  featured Boolean @default(false)

  // One-sentence hero summary shown under the title on the case-study page.
  // Optional — the hero just omits it when blank.
  summary String?

  challenge String

  // Why solving this problem mattered — shown in its own "Opportunity"
  // section on the case-study page, between Challenge and Solution.
  opportunity String?

  solution String
  outcomes String

  // Optional structured proof points. Both stay empty/hidden on the public
  // site until an admin actually fills them in — technologies is a plain
  // list (e.g. ["n8n", "OpenAI", "WhatsApp Business API"]), impactHeadline
  // is a single verified metric line (e.g. "70% reduction in manual
  // processing"). Never auto-generated — only ever set by a human in the
  // admin dashboard.
  technologies   String[] @default([])
  impactHeadline String?

  // Optional "How it works" workflow steps (e.g. ["Input", "Processing",
  // "AI/Automation", "Human review", "Result"]) and "Key features" bullets.
  // Both are plain ordered lists entered one item per line in the admin
  // dashboard; the section is hidden on the public page when empty.
  howItWorks  String[] @default([])
  keyFeatures String[] @default([])

  // Evidence-framework fields — every one is optional, plain human-entered
  // text, and hidden on the public page until filled in. None of these are
  // ever auto-generated or estimated; they only ever hold what an admin has
  // confirmed is true (a verified figure, or something they can calculate
  // from real records). Nothing here should be a guess.
  //
  // processImprovements: bullets describing what manual/duplicate work was
  // removed or what systems got connected (e.g. "Order data no longer
  // re-typed between the store and the accounting system").
  processImprovements String[] @default([])
  // beforeState / afterState: paired bullet lists for a "Before vs After"
  // comparison — plain descriptions, numbers only where genuinely known.
  beforeState String[] @default([])
  afterState  String[] @default([])
  // scaleMetrics / impactMetrics: short "Label: Value" lines (one per line
  // in the admin form), rendered as stat cards — scaleMetrics covers size
  // (users, transactions, documents, workflows), impactMetrics covers
  // measured results (time saved, processing speed, error reduction, etc).
  scaleMetrics  String[] @default([])
  impactMetrics String[] @default([])

  // Optional forward-looking note on scalability/roadmap for this project.
  whatsNext String?

  coverImageUrl String?
  galleryImages String[]

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?

  status ContentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id Int @id @default(1)

  companyName String
  logoUrl     String?

  primaryEmail String
  phoneNumber  String?
  address      String?

  socialLinks Json

  consultationCTA String?
  analyticsId     String?

  metaDefaults Json

  notificationEmails String[]

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id])

  action String

  entityType String?
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())
}

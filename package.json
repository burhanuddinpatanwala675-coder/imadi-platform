{
  "name": "imadi-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "prisma": {
  "seed": "tsx prisma/seed.ts"
},
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:production": "prisma migrate deploy && node dist/src/server.js",
    "test": "vitest run",

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://imadi:change-me@db:5432/imadi?schema=public
# Used only by `prisma migrate deploy`, never by the running app. Local
# docker-compose Postgres has no pooler, so this can match DATABASE_URL. On
# Neon (or any pooled provider), this must be the direct/non-pooled
# connection string (same database, hostname without "-pooler") — otherwise
# migrations time out trying to acquire an advisory lock through the pooler.
DIRECT_URL=postgresql://imadi:change-me@db:5432/imadi?schema=public
SESSION_SECRET=replace-with-a-unique-32-plus-character-secret
# Production: set this to the exact live website origin, for example
# https://imadi-platform-api.onrender.com (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=1
SALES_NOTIFICATION_EMAIL=sales@example.com
PUBLIC_SITE_URL=http://localhost:3000
SEED_ADMIN_PASSWORD=change-this-before-seeding
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Imadi Technologies <no-reply@example.com>
MEDIA_STORAGE=local
MEDIA_MAX_BYTES=5242880
S3_BUCKET=
S3_REGION=
CAPTCHA_SECRET=
